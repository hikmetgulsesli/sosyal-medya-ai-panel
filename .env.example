# ============================================
# Social Media AI Panel - Environment Variables
# ============================================

# ============================================
# Application
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Social Media AI Panel"
NEXT_PUBLIC_APP_URL=http://localhost:3522

# ============================================
# Frontend (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ============================================
# Backend (FastAPI)
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ============================================
# Database - PostgreSQL
# ============================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media_ai

# Individual connection params (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=social_media_ai
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================
# Cache - Redis
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# AI Providers
# ============================================

# MiniMax AI (Primary)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_URL=https://api.minimaxi.chat/v1

# OpenAI (Fallback/Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_optional

# ============================================
# Social Media Platform APIs
# ============================================

# Twitter/X API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Instagram API
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Bluesky (AT Protocol)
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_PASSWORD=your_app_password

# ============================================
# Scraping Configuration
# ============================================
# Path to Scrapling library (if using local development)
SCRAPLING_PATH=/home/setrox/libs/scrapling

# Scraping rate limits (requests per minute)
SCRAPING_RATE_LIMIT_TWITTER=30
SCRAPING_RATE_LIMIT_LINKEDIN=20

# ============================================
# Authentication & Security
# ============================================
# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_min_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Session configuration
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE_DAYS=7

# ============================================
# Cloudflare (for tunnel/proxy)
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token
CLOUDFLARE_ACCOUNT_ID=your_account_id

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_optional

# ============================================
# Feature Flags
# ============================================
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_SMART_SCHEDULING=false
ENABLE_TREND_DETECTION=false
ENABLE_LINKEDIN_SUPPORT=false
ENABLE_INSTAGRAM_SUPPORT=false
ENABLE_BLUESKY_SUPPORT=false
